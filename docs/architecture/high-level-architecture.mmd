block-beta
    columns 19

    space:5
    TITLE["<div style='text-align:center'><b>MEMORY-OPS</b><br/><span>High-Level System Architecture</span><hr/><small>Solid dark · synchronous &nbsp;&nbsp; Purple dashed · asynchronous &nbsp;&nbsp; Red · denied</small></div>"]:9
    space:5

    CLIENT["<div style='text-align:left'><b>01 · Clients</b><br/><small>ENTRY + RESPONSE</small><hr/>Remember · Retrieve<br/>Correct · Forget<br/>Build context<hr/><small>Python · TypeScript · HTTPS</small></div>"]:3
    space:1
    API["<div style='text-align:left'><b>02 · API Gateway</b><br/><small>PUBLIC CONTRACT</small><hr/>Validate request<br/>Resolve API version<br/>Enforce idempotency<br/>Route operation</div>"]:3
    space:1
    AUTH["<div style='text-align:left'><b>03 · Auth &amp; Policy</b><br/><small>TRUST BOUNDARY</small><hr/>Authenticate principal<br/>Derive tenant + workspace<br/>Authorize scope<br/>Block prohibited data<hr/><small>Deny takes precedence</small></div>"]:3
    space:1
    DOMAIN["<div style='text-align:left'><b>04 · Memory Domains</b><br/><small>SEPARATE AUTHORITY</small><hr/><b>User</b> · facts + constraints<br/><b>Agent</b> · evaluated procedures<br/><b>Organization</b> · cited sources<hr/><small>Labels are never flattened</small></div>"]:3
    space:1
    STORE["<div style='text-align:left'><b>05 · Canonical Store</b><br/><small>POSTGRESQL + OBJECTS</small><hr/>Commit immutable versions<br/>Maintain current pointers<br/>Apply lifecycle + grants<br/>Emit transactional outbox<hr/><small>Canonical is authoritative</small></div>"]:3

    space:4
    DENY["<div style='text-align:left'><b>Denied safely</b><hr/><small>No protected operation<br/>Content-free audit only</small></div>"]:3
    space:12

    space:4
    WORKER["<div style='text-align:left'><b>06 · Workers &amp; Indexes</b><br/><small>REBUILDABLE DERIVATIVES</small><hr/>Consume durable outbox<br/>Revalidate policy<br/>Enrich + index<br/>Retry idempotently<br/>Purge every destination<hr/><small>Keyword · vector · optional graph</small></div>"]:3
    space:1
    CONTEXT["<div style='text-align:left'><b>07 · Context Assembly</b><br/><small>AUTHORIZED READ PATH</small><hr/>Pre-filter scope<br/>Retrieve candidate IDs<br/>Hydrate current versions<br/>Budget · label · cite<hr/><small>Warnings · abstention · partial</small></div>"]:3
    space:1
    RESULT["<div style='text-align:left'><b>08 · Response Contract</b><br/><small>STRUCTURED + HONEST</small><hr/>Write acknowledgement<br/>Domain sections + citations<br/>Conflicts + warnings<br/>Degraded status</div>"]:3
    space:4

    space:2
    OBS["<div style='text-align:left'><b>Observability &amp; Evaluation</b><br/><small>CROSS-CUTTING CONTROL PLANE</small><hr/>Receive metadata from API + workers<br/>Content-free logs · metrics · traces · audit<br/>Versioned datasets · baselines · protected holdouts<br/>Gate domain promotion + architecture changes</div>"]:7
    space:1
    FUTURE["<div style='text-align:left'><b>Evaluation-gated future options</b><br/><small>NOT ACTIVE V1 DEPENDENCIES</small><hr/>Redis · Kafka · Kubernetes<br/>Dedicated vector or graph infrastructure</div>"]:7
    space:2

