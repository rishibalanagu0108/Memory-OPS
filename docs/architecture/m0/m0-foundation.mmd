        API[FastAPI<br/>Versioned OpenAPI]
        GUARD[Auth + machine policy<br/>Deny by default]
        DB[(PostgreSQL<br/>Forced tenant RLS)]
        WRITE[Idempotency receipt<br/>+ canonical mutation]
        OUTBOX[(Transactional outbox<br/>Metadata only)]
        WORKER[Worker claim + retry<br/>Lease recovery]
        AUDIT[Content-free audit<br/>Fixed schema]
        EVAL[M0 deterministic gate<br/>Versioned holdout]

        API --> GUARD
        GUARD -->|allowed scope| WRITE
        GUARD -->|denied| STOP[Safe denial]
        WRITE -->|one transaction| DB
        WRITE --> OUTBOX
        OUTBOX -. asynchronous .-> WORKER
        API -. metadata .-> AUDIT
        WORKER -. metadata .-> AUDIT
        EVAL -. verifies .-> GUARD
        EVAL -. verifies .-> DB
        EVAL -. verifies .-> OUTBOX
        EVAL -. verifies .-> AUDIT
    end

