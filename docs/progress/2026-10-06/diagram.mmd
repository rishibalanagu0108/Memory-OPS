flowchart LR
    WRITE[Canonical memory] --> LIFE[Correct · expire · forget]
    LIFE --> PURGE[Deletion receipts + restore replay]
    WRITE --> FILTER[Authorized current-state filter]
    FILTER --> KEYWORD[Keyword retrieval]
    FILTER --> VECTOR[Confidence-gated vector fallback]
    KEYWORD --> HYDRATE[Canonical rehydration]
    VECTOR --> HYDRATE
    HYDRATE --> CONTEXT[Constraints first · token budget · provenance]
    KEYWORD -. compare .-> RRF[RRF candidate]
    VECTOR -. compare .-> RRF
    RRF --> HOLDOUT[Protected holdout]
    HOLDOUT --> SAFE[Quality + safety passed]
    SAFE --> LATENCY[Relative latency missed]
    LATENCY --> OFF[RRF stays disabled]

    classDef core fill:#e6f0ff,stroke:#2666a8,color:#17324d;
    classDef safe fill:#dcf3e5,stroke:#26834f,color:#173c29;
    classDef eval fill:#eee6ff,stroke:#7041b5,color:#371866;
    classDef stop fill:#ffdadd,stroke:#c93643,color:#65141c;

    class WRITE,FILTER,KEYWORD,VECTOR,HYDRATE core
    class LIFE,PURGE,CONTEXT,SAFE safe
    class RRF,HOLDOUT eval
    class LATENCY,OFF stop
